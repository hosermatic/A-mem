<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hodtools.a-mem</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jose/Developer/shared/llm-infrastructure/a-mem/.venv/bin/python</string>
        <string>http_service/run.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jose/Developer/shared/llm-infrastructure/a-mem</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>8101</string>
    </dict>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/a-mem.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/a-mem-error.log</string>
</dict>
</plist>

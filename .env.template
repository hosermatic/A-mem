# Agentic Memory Configuration
# Copy this file to .env and fill in your values

# LLM Backend: openai, ollama, or litellm (recommended)
LLM_BACKEND=litellm

# LiteLLM Gateway settings (recommended - unified model access)
LITELLM_GATEWAY_URL=http://localhost:4000
LITELLM_API_KEY=
# LiteLLM model aliases: memory-evolution (Gemini Pro), metadata (Gemini Flash)
LLM_MODEL=memory-evolution

# OpenAI settings (if using openai backend)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Embedding model (used for vector search)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Ollama settings (if using ollama backend)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# Persistence settings
PERSISTENT=true
PERSIST_DIRECTORY=~/.agentic_memory
MEMORY_NAMESPACE=default

# Legacy ChromaDB settings (deprecated - use PERSIST_DIRECTORY instead)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=agentic_memory

# Server settings
HOST=0.0.0.0
PORT=8100

# Memory evolution settings
EVO_THRESHOLD=100
MAX_MEMORIES=10000
CONSOLIDATION_THRESHOLD=100

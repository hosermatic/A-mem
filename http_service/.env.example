# Agentic Memory HTTP Service Configuration

# Server settings
PORT=8100
HOST=0.0.0.0
RELOAD=false

# LLM Backend: "litellm" (recommended), "openai", or "ollama"
LLM_BACKEND=litellm

# LiteLLM Gateway settings (recommended - unified model access)
LITELLM_GATEWAY_URL=http://localhost:4000
LITELLM_API_KEY=
# LiteLLM model aliases: memory-evolution (Gemini Pro), metadata (Gemini Flash)
LLM_MODEL=memory-evolution

# OpenAI settings (if using openai backend)
OPENAI_API_KEY=your-api-key-here

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# For Ollama backend (if using)
# OLLAMA_BASE_URL=http://localhost:11434

# Persistence settings
PERSISTENT=true
PERSIST_DIRECTORY=~/.agentic_memory
MEMORY_NAMESPACE=default
